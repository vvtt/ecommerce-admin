node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# 采集域运行时数据（SQLite 库 / 转存的图片 / 采集令牌）
server/sourcing/db.sqlite
server/sourcing/db.sqlite-*
server/sourcing/uploads/
server/sourcing/collect-token.txt

# 竞品域运行时数据（SQLite 库 / 插件上报落盘的商品、评论、凭证、原始响应）
server/competitor/shopee.db
server/competitor/shopee.db-*
server/competitor/data/

# 登录会话签名密钥（泄露可伪造任意登录 token）
server/auth-secret.txt

# 内嵌浏览器的 Edge 用户数据（含登录态 Cookie，属机器本机数据）
server/browser/profile/
# 内嵌浏览器的插件挂载清单（路径因机器而异；模板见 extensions.example.json）
server/browser/extensions.json

# WorkBuddy 本地工作数据（工作记忆/会话日志，非项目代码）
.workbuddy/
server/browser/collect-profile/
.tmp-c1688/

# 描述批量生成域运行时数据（SQLite 库 / LLM 配置含 apiKey，严禁入库）
server/descbatch/descbatch.db
server/descbatch/descbatch.db-*
server/descbatch/config.json

# 排障探针的截图/抓包临时产物（探针脚本本身保留）
scripts/.*

# 一次性临时产物（复现脚本、匿名探针 profile、压缩包）
.tmp-*/
tmp-*.mjs
tmp-*.png
start-dev.zip
server/browser/.probe-anon*/
